# Supabase project (Settings -> API Keys). Use the new sb_publishable_/sb_secret_ keys,
# not the legacy anon/service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin of the app, used for the OAuth redirect (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only (@supabase/server). Never expose to the browser; never prefix with NEXT_PUBLIC_.
# JWT verification derives the JWKS URL from SUPABASE_URL, so no SUPABASE_JWKS_URL is needed.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# RLS tests: direct Postgres connection, loaded from .env by vitest (local stack default shown).
# The tests write and delete rows; only point this at a project you can wipe.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
